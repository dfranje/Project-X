+// SSRF guard: only http(s), and the host must not resolve to a private,
+// loopback, link-local or otherwise reserved address (blocks internal
+// services and cloud metadata). NOTE: this does not fully stop DNS rebinding;
+// for that, fetch by the validated IP with the Host header pinned.
+function rIsSafeRemoteUrl($rUrl) {
+    $rParts = @parse_url($rUrl);
+    if (!$rParts || empty($rParts["scheme"]) || empty($rParts["host"])) {
+        return false;
+    }
+    if (!in_array(strtolower($rParts["scheme"]), array("http", "https"))) {
+        return false;
+    }
+    $rHost = $rParts["host"];
+    $rIPs = array();
+    if (filter_var($rHost, FILTER_VALIDATE_IP) !== false) {
+        $rIPs[] = $rHost;
+    } else {
+        $rRecords = @dns_get_record($rHost, DNS_A | DNS_AAAA);
+        if ($rRecords) {
+            foreach ($rRecords as $rRec) {
+                if (!empty($rRec["ip"]))   { $rIPs[] = $rRec["ip"]; }
+                if (!empty($rRec["ipv6"])) { $rIPs[] = $rRec["ipv6"]; }
+            }
+        }
+    }
+    if (count($rIPs) === 0) {
+        return false;
+    }
+    foreach ($rIPs as $rIP) {
+        if (filter_var($rIP, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE) === false) {
+            return false;
+        }
+    }
+    return true;
+}
